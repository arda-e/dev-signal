{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "ardico-signals",
  "post": {
    "entrypoints": {
      "default": {
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {},
  "menu": {
    "items": [
      {
        "label": "[ardico-signals] New Post",
        "description": "Create a new ardico-signals post.",
        "location": "subreddit",
        "endpoint": "/internal/on/menu/new-post"
      },
      {
        "label": "Ardico Inbox: Run Scan",
        "description": "Discover and checkpoint one bounded batch of source posts",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/devsignal-scan"
      },
      {
        "label": "Ardico Inbox: Sync Inbox",
        "description": "Refresh and deliver one selected post with bounded comments to Supabase",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/devsignal-sync"
      },
      {
        "label": "Ardico Inbox: Resume Morning Run",
        "description": "Resume the current daily batch before 09:00 Istanbul",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/devsignal-daily-resume"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on/app/install"
  },
  "scripts": {
    "dev": "npm run watch"
  },
  "dev": {
    "subreddit": "ardico_signals_dev"
  },
  "permissions": {
    "redis": true,
    "http": {
      "enable": true,
      "domains": ["hpklrxtvgrimxjcchpdk.supabase.co"]
    }
  },
  "scheduler": {
    "tasks": {
      "devsignal-daily-batch": {
        "endpoint": "/internal/scheduler/devsignal-daily-start",
        "cron": "0 3 * * *"
      },
      "devsignal-continue-batch": {
        "endpoint": "/internal/scheduler/devsignal-daily-continue"
      }
    }
  },
  "settings": {
    "global": {
      "supabase-project-url": {
        "type": "string",
        "label": "Supabase project URL",
        "defaultValue": "https://hpklrxtvgrimxjcchpdk.supabase.co"
      },
      "supabase-ingest-token": {
        "type": "string",
        "label": "Restricted Supabase ingest token",
        "isSecret": true
      },
      "collector-export-enabled": {
        "type": "boolean",
        "label": "Enable selected post and comment delivery to Supabase",
        "defaultValue": false
      }
    }
  }
}
